# ─── Virtue Aesthetic Clinics — Environment Variables ───────────────────────
# Copy this file to .env.local and fill in real values before running locally.
# NEVER commit .env.local to version control.

# ── Public Variables (exposed to the browser) ─────────────────────────────────

# Canonical site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://virtueaesthetics.com

# Contact details
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_WHATSAPP=

# Social media profile URLs
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# Online booking tool URL (Calendly, Cliniko, SimplePractice, etc.)
NEXT_PUBLIC_BOOKING_URL=

# ── Server-Side Variables (never exposed to the browser) ──────────────────────
# Add secret keys, API tokens, and service credentials below.
# Example: SENDGRID_API_KEY=
# Example: GOOGLE_ANALYTICS_ID=

