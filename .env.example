# Copy to .env.local and fill in. Never commit .env.local.

# ---- Site ----
# Production origin used for canonical URLs, sitemap, robots.txt, Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=https://www.your-clinic-domain.in

# ---- MySQL ----
# The database is created automatically on first connection if the user has CREATE privileges.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=virtue_clinic

# ---- Admin panel (/admin) ----
# Generate both values with:  npm run admin:hash -- "your-strong-password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
